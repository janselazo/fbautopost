# Supabase — from Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Backend URL (optional for local dev)
# For local Cursor dev: leave empty or set to http://localhost:3000
# The app uses the Vite proxy when opened at http://localhost:8000 or http://localhost:8080
# For preview/production: set to your backend origin (e.g. https://your-app.vibecode.run)
VITE_BACKEND_URL=
