# Server
PORT=3000

# Database (Prisma)
DATABASE_URL="file:./dev.db"

# Supabase — from Dashboard → Project Settings → API → JWT Secret (required for auth)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Optional: OpenAI (for AI features e.g. conversations)
# OPENAI_API_KEY=sk-...

# Optional: MarketCheck (Connect Inventory / dealer lookup)
# MARKETCHECK_API_KEY=your_marketcheck_key
# MARKETCHECK_API_SECRET=your_marketcheck_secret

# Optional: Stripe (billing)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_PRO_ANNUAL=price_...
# STRIPE_PRICE_DEALER_MONTHLY=price_...
# STRIPE_PRICE_DEALER_ANNUAL=price_...

# Optional: Better Auth (if used)
# BETTER_AUTH_SECRET=generate_a_random_secret
